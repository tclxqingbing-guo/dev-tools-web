# Project metadata
PROJECT_NAME=bx-tools
PROJECT_ENV=production

# Bootstrap infrastructure
BACKEND_PORT=3001
FRONTEND_PORT=8866

# Unified AI Agent
AGENT_POSTGRES_USER=bx
AGENT_POSTGRES_PASSWORD=bx_pass
AGENT_POSTGRES_DB=bx_agent
AGENT_ENCRYPTION_KEY=replace-with-a-long-random-secret
AGENT_MODEL=
AGENT_CONTEXT_WINDOW=128000
AGENTIC_MAX_ROUNDS=30
AGENTIC_MAX_DURATION_SECONDS=600
AGENT_MAX_UPLOAD_MB=50
SEARXNG_SECRET=replace-with-a-long-random-secret
AGENT_EXTERNAL_API_TOKEN=
AGENT_EXTERNAL_RATE_LIMIT=30

# SSO / authority
SSO_ENABLED=false
SSO_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_PUBLIC_ORIGIN=
SSO_REDIRECT_URI=
SSO_SESSION_SECRET=
SSO_COOKIE_SECURE=false
AUTH_MOCK_ENABLED=false
AUTH_MOCK_USER_ID=local-user
AUTH_MOCK_USERNAME=本地测试用户
AUTH_MOCK_ROLES=admin
AGENT_ALLOW_GUEST=false
AUTHORITY_ALLOWED_ADMIN_ROLE_NAMES=admin
AUTHORITY_ENABLED=false
AUTHORITY_BASE_URL=http://servicegw.ly.com/gateway/authority/interface
AUTHORITY_LABRADOR_TOKEN=
AUTHORITY_APP_KEY=
AUTHORITY_APP_CODE=
AUTHORITY_TID=
AUTHORITY_ALLOWED_ADMIN_ROLE_IDS=
AUTH_ADMIN_USER_IDS=

# Dynamic MCP SSRF guard. Production should explicitly list domain service hosts.
MCP_ALLOWED_HOSTS=backend,kb-server,monitor-collector
MCP_ALLOW_PRIVATE_NETWORK=true
CODEGRAPH_MCP_TOKEN=replace-with-codegraph-service-token
KNOWLEDGE_MCP_URL=http://kb-server:3000/api/mcp
KNOWLEDGE_MCP_TOKEN=replace-with-knowledge-service-token
MONITOR_MCP_URL=http://monitor-collector:3001/api/v1/mcp
MONITOR_MCP_TOKEN=replace-with-monitor-service-token
CODEGRAPH_NEO4J_PASSWORD=bx_codegraph_pass
CODEGRAPH_GITLAB_URL=
CODEGRAPH_GITLAB_TOKEN=
CODEGRAPH_PROJECTS=
CODEGRAPH_BRANCH=master
